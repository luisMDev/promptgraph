#!/bin/sh
# Forwards a Claude Code hook payload (stdin JSON) to the promptgraph server. Never blocks Claude.
# Usage (from hooks.json): pg-hook <session-start|activity|notification|stop>
curl -s -m 2 -X POST \
  -H "Authorization: Bearer $PG_TOKEN" -H "Content-Type: application/json" \
  --data-binary @- "http://127.0.0.1:$PG_PORT/hooks/$PG_NODE_RUN_ID/$1" >/dev/null 2>&1
exit 0
