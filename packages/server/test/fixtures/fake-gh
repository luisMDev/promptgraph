#!/usr/bin/env node
// Fake `gh` CLI for promptgraph tests (PG_GH_BIN). Only `gh --version` and `gh pr create` are emulated:
// - FAKE_GH_LOG=<file>: appends one JSON line per invocation {argv, cwd, stdin, env: GH_*/PG_*}.
// - FAKE_GH_FAIL=<message>: prints the message to stderr and exits 1.
// - FAKE_GH_EXISTS=1: fails like gh does when a PR for the branch already exists (URL in stderr).
// - FAKE_GH_URL: URL printed on success (default https://github.com/fake/repo/pull/1).
import fs from "node:fs";

const argv = process.argv.slice(2);
const url = process.env.FAKE_GH_URL || "https://github.com/fake/repo/pull/1";

function readStdin() {
  try {
    return fs.readFileSync(0, "utf8");
  } catch {
    return "";
  }
}

const usesStdin = argv[argv.indexOf("--body-file") + 1] === "-";
const stdin = usesStdin ? readStdin() : "";

if (process.env.FAKE_GH_LOG) {
  const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => k.startsWith("GH_") || k.startsWith("PG_")));
  fs.appendFileSync(process.env.FAKE_GH_LOG, `${JSON.stringify({ argv, cwd: process.cwd(), stdin, env })}\n`);
}

if (argv[0] === "--version") {
  process.stdout.write("gh version 2.99.0 (fake)\n");
  process.exit(0);
}
if (argv[0] !== "pr" || argv[1] !== "create") {
  process.stderr.write(`fake-gh: unsupported command: ${argv.join(" ")}\n`);
  process.exit(1);
}
if (process.env.FAKE_GH_FAIL) {
  process.stderr.write(`${process.env.FAKE_GH_FAIL}\n`);
  process.exit(1);
}
if (process.env.FAKE_GH_EXISTS === "1") {
  const head = argv[argv.indexOf("--head") + 1];
  process.stderr.write(`a pull request for branch "${head}" into branch "main" already exists:\n${url}\n`);
  process.exit(1);
}
process.stdout.write(`${url}\n`);
