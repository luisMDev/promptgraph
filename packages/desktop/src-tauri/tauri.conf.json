{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "promptgraph",
  "version": "0.1.0",
  "identifier": "dev.promptgraph.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Draw and run graphs of Claude Code steps",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/luisMDev/promptgraph/releases/latest/download/latest.json"],
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
