---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import InstallBox from '../components/InstallBox.astro';

import fanout from '../assets/screens/m4-fanout-lanes.png';
import terminal from '../assets/screens/m2-terminal.png';
import editor from '../assets/screens/m6-editor.png';
import prDialog from '../assets/screens/m4-pr-dialog.png';
import loop from '../assets/screens/m6-run-loop.png';
import report from '../assets/screens/run-report.png';

import darkGlow from '../assets/bg/dark-glow.webp';
import darkCorners from '../assets/bg/dark-corners.webp';
import darkWaves from '../assets/bg/dark-waves.webp';
import darkWavePattern from '../assets/bg/dark-wave-pattern.webp';
import darkLogoTile from '../assets/bg/dark-logo-tile.webp';

// Brand backgrounds, optimised at build time and passed to CSS as --bg-img.
const bgImage = async (src: ImageMetadata, width: number) =>
  `--bg-img:url(${(await getImage({ src, width, format: 'webp', quality: 82 })).src})`;
const bg = {
  hero: await bgImage(darkGlow, 1600),
  mcp: await bgImage(darkCorners, 1920),
  code: await bgImage(darkWavePattern, 900),
  final: await bgImage(darkWaves, 1920),
  footer: await bgImage(darkLogoTile, 840),
};

const repo = 'https://github.com/luisMDev/promptgraph';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = new URL(`${base}/`, Astro.site).href;

const title = 'promptgraph: visual workflows for Claude Code, run in parallel git worktrees';
const description =
  'Draw a graph of Claude Code prompts, slash commands, shell steps, commits, approvals and pull requests. Run it locally: parallel branches get their own git worktree, and every step opens a real Claude Code terminal.';

const installTabs = [
  {
    label: 'Install',
    command: `git clone ${repo}.git\ncd promptgraph && pnpm install && pnpm build\ncd packages/server && pnpm link --global`,
  },
  { label: 'Run', command: 'promptgraph ~/code/my-app' },
  { label: 'Claude Code plugin', command: 'claude mcp add promptgraph -- promptgraph mcp' },
];

// Every view of the app has its own URL (/r/<repo-id>/…); the frame bar shows the one of the screenshot.
const demoRepo = '127.0.0.1:4777/r/demo-app-3f9a1c2e';
const views = [
  {
    id: 'run',
    label: 'Fan-out run',
    path: `${demoRepo}/runs/k3v9q2m7x1ab`,
    src: fanout,
    alt: 'promptgraph canvas during a run: a planning step fans out into three parallel Claude Code steps that merge, then commit, review and open a pull request',
  },
  {
    id: 'terminal',
    label: 'Live terminal',
    path: `${demoRepo}/runs/p8d2w6n4c0tz/nodes/h5r1y7f3b9qe`,
    src: terminal,
    alt: 'The interactive Claude Code terminal of a step, opened from the promptgraph canvas',
  },
  {
    id: 'editor',
    label: 'Graph editor',
    path: `${demoRepo}/graphs/test-fix`,
    src: editor,
    alt: 'The graph editor with the node palette and the inspector',
  },
  {
    id: 'approval',
    label: 'Approvals',
    path: `${demoRepo}/runs/k3v9q2m7x1ab/nodes/s2j8l4x6v0mg`,
    src: prDialog,
    alt: 'Pull request approval dialog showing the diff, title and body before anything is pushed',
  },
  {
    id: 'loop',
    label: 'Loops',
    path: `${demoRepo}/runs/u6c0e2k8z4wa`,
    src: loop,
    alt: 'A test-fix loop on the canvas with its iteration counter',
  },
  {
    id: 'report',
    label: 'Run report',
    path: `${demoRepo}/runs/k3v9q2m7x1ab/report`,
    src: report,
    alt: 'Run report of a fan-out run that opened a pull request',
  },
];

const readme = [
  { id: 'lanes', title: 'Parallel lanes, isolated worktrees' },
  { id: 'terminal', title: 'The real Claude Code terminal' },
  { id: 'approvals', title: 'Nothing leaves without you' },
  { id: 'loops', title: 'Conditions and loops' },
  { id: 'diffs', title: 'Per-step diffs and reports' },
  { id: 'cost', title: 'Tokens and cost' },
];

const nodeTypes = [
  ['Prompt', 'A Claude Code session started with your prompt', '>_'],
  ['Command', 'A slash command or skill, such as /code-review high', '/'],
  ['Shell', 'Any shell command in the step’s worktree; exit 0 is success', '$'],
  ['Commit', 'Stage and commit, with a fixed or generated message', '●'],
  ['Pull request', 'Push the branch and open a draft PR with gh', '⇡'],
  ['Approval', 'Pause until you approve, with the diff in front of you', '✓'],
  ['Merge', 'Join parallel lanes; Claude or you resolve conflicts', '⋈'],
  ['Condition', 'Branch on an exit code, a regex or a Claude judge', '?'],
];

const faqs = [
  {
    q: 'What is promptgraph?',
    a: 'promptgraph is a local tool for orchestrating Claude Code. You draw a graph where each node is a step (a prompt, a slash command, a shell command, a commit, an approval, a merge or a pull request) and run it. Independent branches run in parallel, each in its own git worktree.',
  },
  {
    q: 'Does it replace Claude Code?',
    a: 'No. Every Claude step is a real, interactive Claude Code session started with the flags you configure. promptgraph decides what runs when and where, and gives you a canvas to watch it. You can open any step’s terminal and take over.',
  },
  {
    q: 'Is my code sent anywhere?',
    a: 'promptgraph runs on your machine: one background daemon listens on 127.0.0.1 only, and every request needs its local token or a browser session signed in with a one-time code. Your prompts go to Claude Code exactly as they would if you typed them. Nothing is pushed to a remote without an approval step you accept.',
  },
  {
    q: 'Can Claude run in parallel without the sessions stepping on each other?',
    a: 'Yes. Each parallel branch gets its own git worktree and branch, forked from the state of the lane before it. Sessions never share a working directory. A merge node brings the lanes back together.',
  },
  {
    q: 'Is promptgraph free and open source?',
    a: 'Yes. promptgraph is released under the MIT license. You can use, modify and redistribute it, including in commercial work. You only pay for the Claude Code usage your own sessions consume.',
  },
  {
    q: 'Which platforms are supported?',
    a: 'Linux and WSL, with Node.js 22 or newer, git and a logged-in Claude Code. The GitHub CLI is optional and only needed for pull-request steps. The UI runs in your browser, or in an optional Linux desktop window that you build with Rust.',
  },
  {
    q: 'Can Claude Code drive promptgraph itself?',
    a: 'Yes. promptgraph ships an MCP server and a Claude Code plugin with design-graph, run-graph and review-run skills. Claude can design and run graphs and read their results. Approvals always stay with you, in the UI.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'promptgraph',
    url: pageUrl,
    description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, Windows Subsystem for Linux',
    image: new URL(`${base}/og.png`, Astro.site).href,
    codeRepository: repo,
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <a class="sr-only" href="#main">Skip to content</a>

  <header class="nav">
    <div class="container nav-inner">
      <a class="brand" href={`${base}/`} aria-label="promptgraph home">
        <img src={`${base}/favicon.svg`} alt="" width="24" height="24" />
        <span>promptgraph</span>
      </a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="#product">Product</a></li>
          <li><a href="#how-it-works">How it works</a></li>
          <li><a href="#readme">Features</a></li>
          <li><a href="#claude-code">Plugin</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </nav>
      <div class="nav-cta">
        <a class="nav-link" href={repo}>GitHub</a>
        <a class="btn btn-primary btn-sm" href="#get-started">Get started</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" style={bg.hero}>
      <div class="container">
        <h1>
          Draw your Claude Code workflow.<br />
          <span class="dim">Run it in parallel.</span>
        </h1>
        <p class="lead">
          promptgraph turns prompts, slash commands, shell steps, commits, approvals and pull requests
          into a graph you can run. Independent branches run side by side in their own git worktrees.
          <strong>Click any step to open its real Claude Code terminal.</strong>
        </p>
        <div id="get-started">
          <InstallBox tabs={installTabs} />
        </div>
        <p class="hint">
          Linux and WSL · Node.js 22+ · git · Claude Code ·
          <a href={`${repo}#install-and-build`}>Full install guide →</a>
        </p>
      </div>
    </section>

    <section id="product" class="product" aria-label="Product tour">
      <div class="container">
        <div class="viewer" data-viewer>
          <div class="viewer-tabs" role="tablist" aria-label="Product views">
            <span class="viewer-hint">See it in action:</span>
            {
              views.map((v, i) => (
                <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-view={v.id}>
                  {v.label}
                  <kbd>{i + 1}</kbd>
                </button>
              ))
            }
          </div>
          <div class="frame">
            <div class="frame-bar" aria-hidden="true">
              <span></span><span></span><span></span>
              <em data-frame-url>{views[0]?.path}</em>
            </div>
            {
              views.map((v, i) => (
                <figure data-panel={v.id} data-path={v.path} hidden={i !== 0}>
                  <Image
                    src={v.src}
                    alt={v.alt}
                    widths={[640, 1024, 1600]}
                    sizes="(max-width: 1240px) 100vw, 1180px"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="statement">
      <div class="container">
        <p>
          Plan, implement, test, review, commit, open a PR. You already run that loop by hand, one
          terminal at a time.
          <span class="dim">
            promptgraph writes it down as a graph, runs the independent parts at once in isolated
            worktrees, and stops exactly where you want a say.
          </span>
        </p>
      </div>
    </section>

    <section id="how-it-works" class="section">
      <div class="container">
        <div class="split-head">
          <h2>Sketch it once.<br /><span class="dim">Run it every time.</span></h2>
          <p>
            A graph is a JSON file in your repo. Straight paths share a lane; every fan-out gets its own
            worktree and branch. A merge node joins them back, and an approval gate decides what ships.
          </p>
        </div>
        <FlowDiagram />
        <ol class="trio">
          <li>
            <span class="trio-label">Draw</span>
            <code>.promptgraph/graphs/ship.json</code>
            <p>Drop nodes on the canvas. Each Claude step picks its model, effort, permission mode and context.</p>
          </li>
          <li>
            <span class="trio-label">Run</span>
            <code>pg/ship/711d/l2 · running</code>
            <p>Steps light up as they progress. Click any node to watch it work or type into its session.</p>
          </li>
          <li>
            <span class="trio-label">Ship</span>
            <code>approve → push → gh pr create --draft</code>
            <p>Approve the exact diff. promptgraph pushes that commit and opens a draft pull request.</p>
          </li>
        </ol>
      </div>
    </section>

    <section id="readme" class="section readme">
      <div class="container readme-grid">
        <aside class="toc" aria-label="Features">
          <span class="label">README.md</span>
          <ol>
            {
              readme.map((r, i) => (
                <li>
                  <a href={`#${r.id}`}>
                    <span>{String(i + 1).padStart(2, '0')}</span>
                    {r.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </aside>

        <div class="doc">
          <article id="lanes">
            <h2><span class="hash">##</span> Parallel lanes, isolated worktrees</h2>
            <p>
              Steps never run in your checkout. When the graph fans out, each branch gets its own
              <strong>git worktree</strong> under <code>~/.promptgraph/worktrees</code>, forked from the
              lane before it, so two Claude sessions never edit the same files.
            </p>
            <div class="term">
              <div class="term-row head"><span>LANE</span><span>BRANCH</span><span>STEP</span><span>STATUS</span></div>
              <div class="term-row"><span>main</span><span>pg/ship-feature/711d/main</span><span>Implement API</span><span class="st run">running</span></div>
              <div class="term-row"><span>l2</span><span>pg/ship-feature/711d/l2</span><span>Write tests</span><span class="st run">running</span></div>
              <div class="term-row"><span>l3</span><span>pg/ship-feature/711d/l3</span><span>Update docs</span><span class="st ok">done</span></div>
            </div>
          </article>

          <article id="terminal">
            <h2><span class="hash">##</span> The real Claude Code terminal</h2>
            <p>
              promptgraph never scrapes the TUI. Every Claude step is an interactive session you can open,
              watch and type into. When Claude needs input, the node turns yellow and a desktop
              notification tells you which step is waiting. You choose when a step counts as done:
            </p>
            <dl class="modes">
              <div><dt>auto</dt><dd>Continue a few seconds after Claude’s turn ends, with a <strong>Hold</strong> button.</dd></div>
              <div><dt>manual</dt><dd>Wait until you click <strong>Done</strong>.</dd></div>
              <div><dt>marker</dt><dd>Succeed only when Claude ends with a token you choose.</dd></div>
            </dl>
          </article>

          <article id="approvals">
            <h2><span class="hash">##</span> Nothing leaves without you</h2>
            <p>
              Pull-request steps are gated by an approval by default. You see the exact diff, title and
              body; nothing is pushed until you click approve.
            </p>
            <ul class="checks">
              <li>Daemon bound to <code>127.0.0.1</code>; the token never appears in a URL, and browsers sign in with one-time codes</li>
              <li><code>bypassPermissions</code> is never offered; the default is <code>acceptEdits</code></li>
              <li>Checkpoint commits before every fork and merge, so no work is lost</li>
            </ul>
          </article>

          <article id="loops">
            <h2><span class="hash">##</span> Conditions and loops</h2>
            <p>
              Branch on an exit code, a regex over the previous output, or a yes/no question answered by
              Claude. Loop back on failure: run the tests, let Claude fix them, run them again, up to the
              limit you set.
            </p>
            <pre class="snippet"><code><span class="c"># test-fix loop</span>
run tests ──fail──▶ claude: fix ──▶ run tests   <span class="c">(max 3)</span>
    └──pass──▶ commit ──▶ approval ──▶ draft PR</code></pre>
          </article>

          <article id="diffs">
            <h2><span class="hash">##</span> Per-step diffs and reports</h2>
            <p>
              Every step is snapshotted when it starts and finishes, so <strong>View diff</strong> shows
              exactly what it changed, even after the worktrees are cleaned up. The run report lists each
              step’s result, timing, changes, commits, PR links and cost.
            </p>
          </article>

          <article id="cost">
            <h2><span class="hash">##</span> Tokens and cost</h2>
            <p>
              Input, output and cache tokens are read from each session transcript, with an estimated cost
              per step and per run. Generated commit messages, PR texts and judges are counted too.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section nodes-section">
      <div class="container">
        <div class="center-head">
          <h2>Eight building blocks.<br /><span class="dim">One graph.</span></h2>
          <p>Everything from the first prompt to the merged pull request.</p>
        </div>
        <ul class="nodes">
          {
            nodeTypes.map(([name, desc, glyph]) => (
              <li>
                <span class="glyph" aria-hidden="true">{glyph}</span>
                <div>
                  <h3>{name}</h3>
                  <p>{desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="claude-code" class="section mcp" style={bg.mcp}>
      <div class="container">
        <div class="split-head">
          <h2>Claude draws the graph.<br /><span class="dim">You keep the approvals.</span></h2>
          <p>
            Ask “split this refactor into parallel steps and run it” or “what happened in the last run?”.
            The bundled plugin registers the promptgraph MCP server and adds the
            <code>design-graph</code>, <code>run-graph</code> and <code>review-run</code> skills.
          </p>
        </div>
        <div class="mcp-grid">
          <pre class="code" style={bg.code}><code><span class="c"># inside Claude Code</span>
/plugin marketplace add /path/to/promptgraph
/plugin install promptgraph@promptgraph

<span class="c"># or register the MCP server by hand</span>
claude mcp add promptgraph -- promptgraph mcp</code></pre>
          <ul class="mcp-points">
            <li><strong>Designs</strong><span>Saves and validates graphs from a plain request.</span></li>
            <li><strong>Runs</strong><span>Starts, waits for and cancels runs; marks steps done or retried.</span></li>
            <li><strong>Reviews</strong><span>Reads outputs, diffs and run reports.</span></li>
            <li><strong>Never approves</strong><span>Approval and PR gates stay in your UI.</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="container faq-grid">
        <div>
          <h2>Questions.<br /><span class="dim">Answers.</span></h2>
          <p class="faq-more">
            Something missing? <a href={`${repo}/issues`}>Open an issue</a>.
          </p>
        </div>
        <div class="faq">
          {
            faqs.map(({ q, a }) => (
              <details>
                <summary>
                  <h3>{q}</h3>
                </summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="final" style={bg.final}>
      <div class="container">
        <h2>Stop babysitting terminals.<br /><span class="dim">Draw the flow once.</span></h2>
        <p>Free and open source under the MIT license.</p>
        <InstallBox tabs={installTabs} />
        <div class="final-cta">
          <a class="btn btn-primary" href={repo}>View on GitHub</a>
          <a class="btn btn-ghost" href={`${repo}/tree/main/docs/examples`}>Example graphs</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer" style={bg.footer}>
    <div class="container footer-inner">
      <span class="brand">
        <img src={`${base}/favicon.svg`} alt="" width="20" height="20" />
        promptgraph
      </span>
      <nav aria-label="Footer">
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/docs/DESIGN.md`}>Design</a>
        <a href={`${repo}/tree/main/docs/examples`}>Examples</a>
        <a href={`${repo}/issues`}>Issues</a>
        <a href={`${repo}/blob/main/LICENSE`}>MIT License</a>
      </nav>
      <p class="fine">Not affiliated with Anthropic. Claude and Claude Code are trademarks of Anthropic.</p>
    </div>
  </footer>
</Base>

<script>
  // Product viewer: tabs and number keys 1-6 switch the screenshot.
  const viewer = document.querySelector<HTMLElement>('[data-viewer]');
  if (viewer) {
    const tabs = [...viewer.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const panels = [...viewer.querySelectorAll<HTMLElement>('[data-panel]')];
    const frameUrl = viewer.querySelector<HTMLElement>('[data-frame-url]');
    const show = (id: string) => {
      for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.view === id));
      for (const p of panels) {
        p.hidden = p.dataset.panel !== id;
        if (!p.hidden && frameUrl) frameUrl.textContent = p.dataset.path ?? '';
      }
    };
    for (const t of tabs) t.addEventListener('click', () => show(t.dataset.view!));
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('input, textarea, [contenteditable]') || e.metaKey || e.ctrlKey || e.altKey) return;
      const tab = tabs[Number(e.key) - 1];
      if (tab && viewer.getBoundingClientRect().top < innerHeight) show(tab.dataset.view!);
    });
  }

  // Highlight the README entry of the article in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.hash.slice(1), a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links.values()) a.classList.remove('active');
        links.get(entry.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  for (const id of links.keys()) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }
</script>

<style>
  /* Navigation */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(10 10 11 / 0.72);
    backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand img {
    border-radius: 6px;
  }
  .nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a,
  .nav-link {
    text-decoration: none;
    color: var(--ink-2);
    font-size: 14px;
    transition: color 0.15s ease;
  }
  .nav ul a:hover,
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .btn-sm {
    padding: 6px 14px;
    font-size: 14px;
  }
  @media (max-width: 860px) {
    .nav nav {
      display: none;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 112px 0 72px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -10% -18% -10% 38%;
    z-index: -1;
    background: var(--bg-img) center / cover no-repeat;
    opacity: 0.55;
    mask-image: radial-gradient(closest-side, #000 45%, transparent 100%);
  }
  h1 {
    font-size: clamp(40px, 6.4vw, 76px);
    text-wrap: balance;
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 980px;
  }
  .lead {
    max-width: 600px;
    margin: 32px 0 36px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .lead strong {
    color: var(--ink);
    font-weight: 500;
  }
  .hint {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .hint a {
    color: var(--ink-2);
    text-underline-offset: 3px;
  }
  .hint a:hover {
    color: var(--ink);
  }

  /* Product viewer */
  .product {
